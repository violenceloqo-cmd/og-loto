# --- Public (NEXT_PUBLIC_) — exposed to the browser ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# devnet or mainnet-beta
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet-beta

# --- Server-only — never expose to the browser ---

# Supabase service role (full DB access)
SUPABASE_SERVICE_ROLE_KEY=

# Helius
HELIUS_API_KEY=
# Set this to any random secret; Helius will send it back in the Authorization header
HELIUS_WEBHOOK_SECRET=

# 12 or 24 word BIP39 mnemonic. Used to deterministically derive per-round
# per-number deposit keypairs at path m/44'/501'/{roundId}'/{n}'.
# GENERATE WITH: `npx --yes bip39-cli` or any reputable offline generator.
# Keep a paper backup. If exposed, ROTATE.
MASTER_MNEMONIC=

# Treasury keypair secret. Either base58-encoded 64 bytes (Phantom export format),
# or a JSON array of bytes like [1,2,3,...].
# Pays out winners. Also receives swept deposits IF RECEIVE_WALLET_ADDRESS is unset.
TREASURY_PRIVATE_KEY=

# Optional: public address that receives swept funds from per-number deposit wallets.
# If set, all sweeps go here instead of the treasury. Payouts still come FROM the
# treasury. Only the address is needed (no private key) since this wallet only
# receives. If unset, sweeps fall back to the treasury address.
RECEIVE_WALLET_ADDRESS=

# Cloudflare Turnstile (server-side verify key)
TURNSTILE_SECRET_KEY=

# Shared secret protecting /api/cron/tick. Vercel Cron will send `Bearer ${CRON_SECRET}`.
CRON_SECRET=

# Public URL of this app (used to register the Helius webhook callback).
# LOCAL DEV: Helius cannot reach localhost — use an ngrok URL, e.g. https://abc123.ngrok-free.app
# PRODUCTION: your Vercel URL, e.g. https://your-app.vercel.app
APP_URL=https://your-app.vercel.app
