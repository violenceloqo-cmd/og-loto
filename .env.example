# --- Public (NEXT_PUBLIC_) — exposed to the browser ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# devnet or mainnet (production)
NEXT_PUBLIC_SOLANA_CLUSTER=mainnet
# Token mint shown in the CA button (should match LOTTO_TOKEN_MINT)
NEXT_PUBLIC_LOTTO_TOKEN_MINT=


# --- Server-only — never expose to the browser ---

# Supabase service role (full DB access)
SUPABASE_SERVICE_ROLE_KEY=

# SPL mint address of the project token. A wallet must hold
# LOTTO_MIN_TOKEN_AMOUNT_UI of this token to enter a round.
LOTTO_TOKEN_MINT=
# Minimum UI-amount required. Decimals are handled by the RPC's parsed
# tokenAmount.uiAmount, so this is the human-readable number (e.g. 100000).
LOTTO_MIN_TOKEN_AMOUNT_UI=100000

# Optional: Helius API key for a faster Solana RPC endpoint. If unset, the
# app falls back to the public mainnet/devnet RPC.
HELIUS_API_KEY=

# Treasury keypair secret. Either base58-encoded 64 bytes (Phantom export format),
# or a JSON array of bytes like [1,2,3,...]. Pays out winners.
TREASURY_PRIVATE_KEY=

# Shared secret protecting /api/cron/tick. Vercel Cron will send `Bearer ${CRON_SECRET}`.
CRON_SECRET=
